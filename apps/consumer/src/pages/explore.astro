---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/site/SiteHeader.astro";
import { MapExplorer } from "../components/map/MapExplorer";

// The discovery map on its own address: the same map, list and filters as the
// home page (approved 2026-11-14), so links to /explore open straight into it.
export const prerender = true;
---

<BaseLayout title="Explore" description="Find a cafe in Cagayan de Oro and step inside before you go." chrome="bare">
  <h1 class="sr-only">Explore cafes in Cagayan de Oro</h1>
  <SiteHeader map />
  <MapExplorer
    client:only="react"
    mode="hero"
    title="Explore cafes"
    lede="Every cafe on Visita in Cagayan de Oro. Amber pins have a 3D walkthrough you can step into."
  />
</BaseLayout>
