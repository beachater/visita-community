---
import BaseLayout from "../layouts/BaseLayout.astro";
import AmberCta from "../components/kit/AmberCta.astro";
import BenefitsShowcase from "../components/marketing/BenefitsShowcase.astro";

export const prerender = true;

// Approved redesign (2026-11-14). Copy: BEA-9 `copy` document, revision 2,
// plus the section headings and buttons approved with the redesign.
// Pricing is "contact us" by decision; don't add figures without sign-off.
// One amber call to action per page (the hero); the closing one is ocean.

const steps = [
  { title: "Get in touch.", body: "Tell us about your cafe." },
  { title: "We visit and scan.", body: "It takes a single visit, at a time that suits you." },
  { title: "Your walkthrough goes live.", body: "We set up your listing with you and give you access to update it." },
  { title: "Keep it fresh.", body: "Your listing shows its scan date. When your space changes, we rescan." },
];
// The owner app (apps/admin) has the claim form; until its address is set,
// owners reach us through the contact page.
const ownerApp = import.meta.env.PUBLIC_OWNER_APP_URL;
const claimHref = ownerApp ? `${ownerApp.replace(/\/$/, "")}/claim` : "/contact";
const pin = "M17 1C8 1 1 8 1 16.6 1 28.5 17 43 17 43S33 28.5 33 16.6C33 8 26 1 17 1Z";
const eyebrow = "text-xs font-bold tracking-[0.12em] text-muted-foreground uppercase";
const outline = "inline-flex h-12 items-center rounded-full border border-border bg-card px-5 text-[0.95rem] font-semibold text-foreground hover:bg-accent";
---

<BaseLayout
  title="For cafe owners"
  description="Let people in Cagayan de Oro walk through your cafe in 3D before they visit. Real scans, a listing you control, and visitor numbers you can see."
>
  <main class="mx-auto grid max-w-6xl gap-16 px-4 pt-8 pb-10 sm:gap-24 md:pt-14">
    <!-- Hero: the promise, and what a visitor sees -->
    <section class="grid items-center gap-10 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,1fr)] lg:gap-14">
      <div class="grid gap-5">
        <p class={eyebrow}>For cafe owners</p>
        <h1 class="text-[2.375rem] leading-[1.04] tracking-[-0.03em] sm:text-6xl">Let people walk in before they walk in.</h1>
        <p class="max-w-[52ch] text-base leading-relaxed text-muted-foreground sm:text-lg">
          Most people decide where to go before they leave the house. With a Visita walkthrough, they can see your real space from their phone and arrive knowing it suits them.
        </p>
        <div class="flex flex-col gap-3 pt-2 sm:flex-row sm:items-center">
          <AmberCta href="/contact" class="h-14 rounded-full px-7 text-base font-bold">Get your cafe on Visita</AmberCta>
          <a href="#claim" class={`${outline} h-14 justify-center px-6`}>Already listed? Claim it</a>
        </div>
      </div>
      <div class="relative h-64 sm:h-[27.5rem]" aria-hidden="true">
        <div class="absolute inset-0 overflow-hidden rounded-[1.75rem] bg-scan sm:right-10 sm:bottom-10 sm:rounded-[2rem]">
          <svg viewBox="0 0 520 400" preserveAspectRatio="xMidYMid slice" class="absolute inset-0 size-full"><path d="M0 400 L150 230 L370 230 L520 400Z" fill="#0B3B6B" /><path d="M150 230 L150 60 L370 60 L370 230Z" fill="#0E4478" /><path d="M0 0 L150 60 L150 230 L0 400Z" fill="#093561" /><path d="M520 0 L370 60 L370 230 L520 400Z" fill="#093561" /><rect x="190" y="130" width="60" height="100" rx="6" fill="#185FA5" /><rect x="270" y="150" width="70" height="22" rx="6" fill="#FAC775" opacity=".5" /></svg>
          <span class="absolute top-4 left-4 rounded-full bg-verified px-3 py-1.5 text-xs font-bold text-verified-foreground">Scanned in 3D</span>
        </div>
        <div class="surface-raised absolute right-0 bottom-0 hidden w-75 gap-2 rounded-card p-4.5 sm:grid">
          <div class="flex items-center gap-2.5">
            <svg viewBox="0 0 34 44" class="h-9.5 w-7.5"><path d={pin} fill="#EF9F27" stroke="#fff" stroke-width="2" /><circle cx="17" cy="16" r="6" fill="#042C53" /></svg>
            <strong class="font-display text-lg">Your cafe</strong>
          </div>
          <p class="text-[0.8rem] text-muted-foreground">Amber pin on the map · menu, hours and events you update yourself</p>
        </div>
      </div>
    </section>

    <BenefitsShowcase />

    <!-- Why honesty works: a calm navy band -->
    <section aria-labelledby="honesty" class="grid gap-4 rounded-[1.75rem] bg-scan p-6 text-white sm:gap-12 sm:rounded-[2rem] sm:p-14 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] lg:items-center">
      <h2 id="honesty" class="text-[1.625rem] leading-[1.1] text-white sm:text-[2.5rem]">Why honesty works in your favour</h2>
      <p class="text-[0.95rem] leading-[1.7] text-cloud sm:text-[1.0625rem]">
        Visitors know Visita doesn't edit or stage anything, so they trust what they see. The people who come in are the ones who already like what they saw: the
        laptop crowd who checked your outlets, or the group who checked you have a big table. That means fewer disappointed walk-outs and more people who come back.
      </p>
    </section>

    <!-- How it works: four steps on one line (stacked on phones) -->
    <section aria-labelledby="how-it-works" class="grid gap-8">
      <div class="grid gap-2.5">
        <p class={eyebrow}>How it works</p>
        <h2 id="how-it-works" class="text-3xl leading-[1.08] sm:text-[2.5rem]">From hello to live, in four steps.</h2>
      </div>
      <ol class="relative grid gap-5 lg:grid-cols-4 lg:gap-7">
        <li class="absolute top-[1.3rem] right-6 left-6 hidden h-0.5 bg-mist lg:block" aria-hidden="true"></li>
        {steps.map((s, i) => (
          <li class="relative grid grid-cols-[2.5rem_1fr] gap-x-3.5 gap-y-1 lg:grid-cols-1 lg:gap-2.5">
            <span class="row-span-2 grid size-10 place-items-center rounded-full bg-scan font-display text-white ring-[6px] ring-background lg:row-span-1 lg:size-11" aria-hidden="true">{i + 1}</span>
            <h3 class="pt-2 font-display text-[1.0625rem] lg:pt-1.5 lg:text-[1.1875rem]">{s.title}</h3>
            <p class="text-sm leading-relaxed text-muted-foreground lg:text-[0.95rem]">{s.body}</p>
          </li>
        ))}
      </ol>
    </section>

    <!-- Pricing and claiming -->
    <section class="grid gap-3 sm:grid-cols-2 sm:gap-5">
      <div class="grid content-start gap-3 rounded-card bg-card p-6 shadow-card sm:p-8">
        <p class={eyebrow}>Pricing</p>
        <h3 class="font-display text-xl sm:text-2xl">Every cafe is different.</h3>
        <p class="leading-relaxed text-muted-foreground">So we'll talk it through with you first. Contact us and we'll explain the options. There's no commitment.</p>
        <a href="/contact" class={`${outline} mt-1 w-fit`}>Contact us</a>
      </div>
      <div id="claim" class="grid scroll-mt-28 content-start gap-3 rounded-card bg-card p-6 shadow-card sm:p-8">
        <p class={eyebrow}>Already on the map?</p>
        <h3 class="font-display text-xl sm:text-2xl">Claim your listing.</h3>
        <p class="leading-relaxed text-muted-foreground">If your cafe is already listed, you can claim it. Sign up as the owner and we'll confirm the cafe is yours before giving you access.</p>
        <a href={claimHref} class={`${outline} mt-1 w-fit`}>Claim your cafe</a>
      </div>
    </section>

    <!-- Closing call (ocean: amber is used once, in the hero) -->
    <section class="flex flex-col items-center gap-5 rounded-[1.75rem] bg-card p-6 text-center shadow-card sm:flex-row sm:justify-between sm:rounded-[2rem] sm:px-14 sm:py-12 sm:text-left">
      <div class="flex flex-col items-center gap-5 sm:flex-row sm:gap-6">
        <span class="grid size-16 shrink-0 place-items-center rounded-[1.375rem] bg-[#004aad] sm:size-19"><img src="/brand/visita-mark.svg" alt="" class="w-10 sm:w-12" /></span>
        <h2 class="text-[1.625rem] sm:text-[2.125rem]">Ready when you are.</h2>
      </div>
      <a href="/contact" class="inline-flex h-13 w-full items-center justify-center rounded-full bg-primary px-7 text-base font-semibold text-primary-foreground hover:bg-primary/90 sm:h-14 sm:w-auto">
        Get your cafe on Visita
      </a>
    </section>
  </main>
</BaseLayout>
