---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/kit/PageHeader.astro";
import { buttonVariants } from "@visita/ui/button";

// Shown for any address that doesn't exist, including a cafe that was
// unpublished or never listed. Rendered on request so the cafe page can
// rewrite to it (Astro forbids rewriting to a prerendered page).
export const prerender = false;
---

<BaseLayout title="Page not found">
  <main class="mx-auto grid max-w-2xl gap-6 px-4 py-16">
    <PageHeader eyebrow="404" title="We couldn't find that page" lede="The cafe may have been unlisted, or the link has a typo." class="pb-0" />
    <div class="flex flex-wrap gap-2">
      <a href="/explore" class={buttonVariants({})}>Explore cafes on the map</a>
      <a href="/" class={buttonVariants({ variant: "outline" })}>Go home</a>
    </div>
  </main>
</BaseLayout>
