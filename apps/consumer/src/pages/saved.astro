---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/kit/PageHeader.astro";
import { SavedList } from "../components/account/SavedList";
import { loginHref } from "../components/site/nav";

// Same for every visitor: the list comes from this device and, when signed
// in, the account (via /api/saved), so the shell is prerendered.
export const prerender = true;
---

<BaseLayout title="Saved cafes">
  <main class="mx-auto max-w-2xl px-4 py-10">
    <PageHeader title="Saved cafes" />
    <SavedList client:load loginHref={loginHref("/saved")} />
  </main>
</BaseLayout>
