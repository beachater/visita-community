---
import "../styles/global.css";
import SiteHeader from "../components/site/SiteHeader.astro";
import SiteFooter from "../components/site/SiteFooter.astro";
import ConsentBanner from "../components/site/ConsentBanner.astro";

interface Props {
  title: string;
  description?: string;
  /**
   * "site": header, footer and consent notice (default).
   * "bare": just the page, for full-screen views like the map and walkthrough,
   * which bring their own controls. The consent notice still shows.
   */
  chrome?: "site" | "bare";
}

const { title, description, chrome = "site" } = Astro.props;
const pageTitle = title === "Visita" ? title : `${title} · Visita`;
// Prerendered pages see their output file (/cafe/sonnys.html) as the path;
// share URLs never carry the extension.
const canonicalPath = Astro.url.pathname.replace(/(\/index)?\.html$/, "") || "/";
const canonical = new URL(canonicalPath, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#042c53" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    <slot name="head" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Visita" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={pageTitle} />
    {description && <meta property="og:description" content={description} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,700&family=Playfair+Display:wght@600;700&display=swap"
    />
  </head>
  <body class="min-h-dvh flex flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-card focus:px-4 focus:py-2 focus:shadow"
    >
      Skip to content
    </a>
    {chrome === "site" && <SiteHeader />}
    <div id="main" class="flex-1">
      <slot />
    </div>
    {chrome === "site" && <SiteFooter />}
    <ConsentBanner />
  </body>
</html>
