---
import { EyeOff, Star } from "lucide-react";
import { cn } from "@visita/ui/utils";

// One review. The author's own review is marked, and if a moderator hid it,
// only they see it, with a notice saying so.
interface Props {
  name: string;
  avatarUrl: string | null;
  rating: number;
  body: string | null;
  photoUrl: string | null;
  createdAt: string;
  own: boolean;
  hidden: boolean;
}
const { name, avatarUrl, rating, body, photoUrl, createdAt, own, hidden } = Astro.props;
const date = new Intl.DateTimeFormat("en-PH", { month: "short", day: "numeric", year: "numeric", timeZone: "Asia/Manila" }).format(new Date(createdAt));
---

<article class={cn("grid gap-2 rounded-xl border bg-card p-4", own && "border-primary/40")}>
  <header class="flex items-center gap-3">
    {
      avatarUrl ? (
        <img src={avatarUrl} alt="" width="36" height="36" class="size-9 rounded-full object-cover" referrerpolicy="no-referrer" loading="lazy" />
      ) : (
        <span class="grid size-9 place-items-center rounded-full bg-muted font-medium" aria-hidden="true">{name.charAt(0).toUpperCase()}</span>
      )
    }
    <div class="min-w-0 flex-1">
      <p class="truncate font-medium">{name}{own && <span class="ml-2 text-xs font-bold uppercase tracking-wide text-primary">Your review</span>}</p>
      <p class="flex items-center gap-2 text-xs text-muted-foreground">
        <span class="flex text-rating" role="img" aria-label={`${rating} out of 5 stars`}>
          {[1, 2, 3, 4, 5].map((i) => <Star className={cn("size-3.5", i <= rating ? "fill-current" : "opacity-30")} aria-hidden="true" />)}
        </span>
        <time datetime={createdAt}>{date}</time>
      </p>
    </div>
  </header>
  {
    hidden && (
      <p class="flex items-center gap-2 rounded-md bg-muted px-3 py-2 text-sm">
        <EyeOff className="size-4 shrink-0" aria-hidden="true" /> Hidden by a moderator. Only you can see it.
      </p>
    )
  }
  {body && <p class="whitespace-pre-line text-sm leading-relaxed">{body}</p>}
  {
    photoUrl && (
      <a href={`/assets/${photoUrl}`} class="w-fit" target="_blank" rel="noopener">
        <img src={`/assets/${photoUrl}`} alt={`Photo from ${name}'s review`} class="max-h-56 rounded-lg border object-cover" loading="lazy" />
      </a>
    )
  }
</article>
