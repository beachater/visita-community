---
import { Star } from "lucide-react";
import { ratingSummary } from "../../lib/reviews/summary";
import { loginHref } from "../site/nav";
import ReviewCard from "./ReviewCard.astro";
import { ReviewSheet } from "./ReviewSheet";

// Reviews on a cafe page (PRD 4.3), as a server island so the page itself
// stays cached: visible reviews newest first with the average, plus your own
// review even when a moderator hid it. RLS decides what each visitor sees.
interface Props {
  venueId: string;
  slug: string;
  cafeName: string;
}
const { venueId, slug, cafeName } = Astro.props;
const { user, supabase } = Astro.locals;

type Row = {
  id: string;
  author_id: string;
  rating: number;
  body: string | null;
  photo_url: string | null;
  status: "visible" | "hidden";
  created_at: string;
  profiles: { display_name: string | null; avatar_url: string | null } | null;
  review_replies: { body: string; created_at: string } | null;
};

let rows: Row[] = [];
let failed = false;
if (supabase) {
  const { data, error } = await supabase
    .from("reviews")
    .select("id, author_id, rating, body, photo_url, status, created_at, profiles(display_name, avatar_url), review_replies(body, created_at)")
    .eq("venue_id", venueId)
    .order("created_at", { ascending: false })
    .limit(100);
  failed = Boolean(error);
  rows = (data ?? []) as Row[];
} else {
  failed = true;
}

const own = user ? (rows.find((r) => r.author_id === user.id) ?? null) : null;
const others = rows.filter((r) => r !== own && r.status === "visible");
const { average, count } = ratingSummary(rows.filter((r) => r.status === "visible").map((r) => r.rating));
const next = `/cafe/${slug}?review=1`;
---

<section id="reviews" class="grid gap-4" aria-labelledby="reviews-title">
  <div class="flex flex-wrap items-end justify-between gap-3">
    <div class="grid gap-1">
      <h2 id="reviews-title" class="font-display text-2xl font-semibold">Reviews</h2>
      {
        average !== null ? (
          <p class="flex items-center gap-1.5 text-sm" aria-label={`Rated ${average.toFixed(1)} out of 5 from ${count} ${count === 1 ? "review" : "reviews"}`}>
            <Star className="size-4 fill-current text-rating" aria-hidden="true" />
            <span class="font-medium tabular-nums">{average.toFixed(1)}</span>
            <span class="text-muted-foreground">({count} {count === 1 ? "review" : "reviews"})</span>
          </p>
        ) : (
          !failed && <p class="text-sm text-muted-foreground">No reviews yet. Be the first.</p>
        )
      }
    </div>
    {
      !failed && (
        <ReviewSheet
          client:load
          slug={slug}
          cafeName={cafeName}
          signedIn={Boolean(user)}
          loginHref={loginHref(next)}
          existing={own ? { rating: own.rating, body: own.body, photoUrl: own.photo_url } : null}
        />
      )
    }
  </div>

  {failed && <p class="text-sm text-muted-foreground">Reviews aren't available right now.</p>}

  {
    own && (
      <ReviewCard
        name={own.profiles?.display_name ?? "You"}
        avatarUrl={own.profiles?.avatar_url ?? null}
        rating={own.rating}
        body={own.body}
        photoUrl={own.photo_url}
        createdAt={own.created_at}
        own
        hidden={own.status === "hidden"}
        reply={own.review_replies}
      />
    )
  }
  {
    others.map((r) => (
      <ReviewCard
        name={r.profiles?.display_name ?? "Visita member"}
        avatarUrl={r.profiles?.avatar_url ?? null}
        rating={r.rating}
        body={r.body}
        photoUrl={r.photo_url}
        createdAt={r.created_at}
        own={false}
        hidden={false}
        reply={r.review_replies}
      />
    ))
  }
</section>
