---
import { Star } from "lucide-react";
import { loadFirstReviewPage, toClientReview, type FirstReviewPage } from "../../lib/reviews/page";
import { loginHref } from "../site/nav";
import { MoreReviews } from "./MoreReviews";
import { ReviewCard } from "./ReviewCard";
import { ReviewSheet } from "./ReviewSheet";

// Reviews on a cafe page (PRD 4.3), as a server island so the page itself
// stays cached: your own review first (even when a moderator hid it), then
// visible reviews newest first, a page at a time (BEA-18). The count and
// average come from the database, not from the rows shown. RLS decides what
// each visitor sees.
interface Props {
  venueId: string;
  slug: string;
  cafeName: string;
}
const { venueId, slug, cafeName } = Astro.props;
const { user, supabase } = Astro.locals;

let first: FirstReviewPage | null = null;
if (supabase) {
  first = await loadFirstReviewPage(supabase, venueId, user?.id ?? null).catch(() => null);
}
const failed = first === null;
const own = first?.own ?? null;
const { average, count } = first?.summary ?? { average: null, count: 0 };
const next = `/cafe/${slug}?review=1`;
---

<section id="reviews" class="grid gap-4" aria-labelledby="reviews-title">
  <div class="flex flex-wrap items-end justify-between gap-3">
    <div class="grid gap-1">
      <h2 id="reviews-title" class="font-display text-2xl font-semibold">Reviews</h2>
      {
        average !== null ? (
          <p class="flex items-center gap-1.5 text-sm" aria-label={`Rated ${average.toFixed(1)} out of 5 from ${count} ${count === 1 ? "review" : "reviews"}`}>
            <Star className="size-4 fill-current text-rating" aria-hidden="true" />
            <span class="font-medium tabular-nums">{average.toFixed(1)}</span>
            <span class="text-muted-foreground">({count} {count === 1 ? "review" : "reviews"})</span>
          </p>
        ) : (
          !failed && <p class="text-sm text-muted-foreground">No reviews yet. Be the first.</p>
        )
      }
    </div>
    {
      !failed && (
        <ReviewSheet
          client:load
          slug={slug}
          cafeName={cafeName}
          signedIn={Boolean(user)}
          loginHref={loginHref(next)}
          existing={own ? { rating: own.rating, body: own.body, photoUrl: own.photo_url } : null}
        />
      )
    }
  </div>

  {failed && <p class="text-sm text-muted-foreground">Reviews aren't available right now.</p>}

  {
    own && (
      <ReviewCard review={toClientReview(own, true)} />
    )
  }
  {
    first?.reviews.map((r) => <ReviewCard review={toClientReview(r, false)} />)
  }
  {first?.nextCursor && <MoreReviews client:visible slug={slug} cursor={first.nextCursor} />}
</section>
