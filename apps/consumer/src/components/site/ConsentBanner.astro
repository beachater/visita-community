---
import { buttonVariants } from "@visita/ui/button";
import { cn } from "@visita/ui/utils";

// Storage and usage-data notice (RA 10173). Two honest choices:
//   "Allow usage stats" → first-party analytics may record page and
//                         walkthrough events (what venue owners see).
//   "Essential only"    → only what the site needs to work: sign-in session,
//                         saved and recently viewed cafes, this choice.
// The choice is read by the analytics code via getConsent() in lib/consent.ts.
---

<section
  id="consent-banner"
  hidden
  aria-label="Privacy choices"
  class="pointer-events-none fixed inset-x-0 bottom-0 z-50 px-3"
  style="padding-bottom: calc(env(safe-area-inset-bottom, 0px) + 0.75rem)"
>
  <div class="surface-raised pointer-events-auto mx-auto flex max-w-4xl flex-col gap-3 rounded-card px-5 py-4 sm:flex-row sm:items-center sm:gap-6">
    <p class="text-sm">
      Visita keeps a little data on this device so the site works: your sign-in, saved cafes and recently viewed.
      With your OK, we also count visits and walkthrough opens so cafes can see how their listing is doing.
      No advertising trackers. <a href="/privacy" class="font-medium text-primary underline underline-offset-2">Privacy policy</a>
    </p>
    <div class="flex shrink-0 gap-2">
      <button type="button" data-consent="essential" class={cn(buttonVariants({ variant: "outline" }), "flex-1 sm:flex-none")}>Essential only</button>
      <button type="button" data-consent="all" class={cn(buttonVariants({ variant: "default" }), "flex-1 sm:flex-none")}>Allow usage stats</button>
    </div>
  </div>
</section>

<script>
  import { getConsent, setConsent, type ConsentChoice } from "../../lib/consent";

  // While the notice shows, floating UI at the bottom of the screen (map pin
  // cards, controls) lifts by its height via --consent-h, so nothing hides behind it.
  const root = document.documentElement;
  const banner = document.getElementById("consent-banner");
  if (banner && getConsent() === null) {
    banner.hidden = false;
    const sync = () => root.style.setProperty("--consent-h", `${banner.offsetHeight}px`);
    const observer = new ResizeObserver(sync);
    observer.observe(banner);
    sync();
    for (const button of banner.querySelectorAll<HTMLButtonElement>("[data-consent]")) {
      button.addEventListener("click", () => {
        setConsent(button.dataset.consent as ConsentChoice);
        banner.hidden = true;
        observer.disconnect();
        root.style.removeProperty("--consent-h");
      });
    }
  }
</script>
