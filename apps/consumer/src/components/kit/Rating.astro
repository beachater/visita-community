---
import { Star } from "lucide-react";
import { cn } from "@visita/ui/utils";

// Star rating (display only). Stars use --rating (amber deep), which reads on
// light surfaces; the number is always shown too, never stars alone.
interface Props {
  value: number;
  count?: number;
  class?: string;
}
const { value, count, class: className } = Astro.props;
const rounded = Math.round(value * 2) / 2;
---

<span class={cn("inline-flex items-center gap-1.5 text-sm", className)} aria-label={`Rated ${value.toFixed(1)} out of 5${count ? ` from ${count} reviews` : ""}`}>
  <span class="flex text-rating" aria-hidden="true">
    {[1, 2, 3, 4, 5].map((i) => (
      <Star className={cn("size-4", i <= rounded ? "fill-current" : i - 0.5 === rounded ? "fill-current opacity-50" : "opacity-30")} />
    ))}
  </span>
  <span class="font-medium tabular-nums">{value.toFixed(1)}</span>
  {count !== undefined && <span class="text-muted-foreground">({count})</span>}
</span>
