---
import { cn } from "@visita/ui/utils";

interface Props {
  title: string;
  eyebrow?: string;
  lede?: string;
  class?: string;
}
const { title, eyebrow, lede, class: className } = Astro.props;
---

<header class={cn("grid gap-2 pb-6", className)}>
  {eyebrow && <p class="text-xs font-bold uppercase tracking-wider text-muted-foreground">{eyebrow}</p>}
  <h1 class="font-display text-4xl font-bold leading-tight sm:text-5xl">{title}</h1>
  {lede && <p class="max-w-[65ch] text-lg text-muted-foreground">{lede}</p>}
  <slot />
</header>
