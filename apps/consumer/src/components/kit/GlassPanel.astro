---
import { cn } from "@/lib/utils";

// Frosted panel that floats over the 3D scan (the walkthrough info panel,
// map overlays). Readable over any part of the room.
interface Props {
  class?: string;
  as?: "div" | "section" | "aside";
  label?: string;
}
const { class: className, as: Tag = "div", label } = Astro.props;
---

<Tag
  aria-label={label}
  class={cn(
    "rounded-xl border border-glass-border bg-glass text-glass-foreground shadow-lg backdrop-blur-md",
    className,
  )}
>
  <slot />
</Tag>
