---
import { cn } from "@visita/ui/utils";

// Reading panel that floats over the 3D scan (the walkthrough info panel,
// map overlays): near-solid Deep Navy, so text never sits on the moving room.
interface Props {
  class?: string;
  as?: "div" | "section" | "aside";
  label?: string;
}
const { class: className, as: Tag = "div", label } = Astro.props;
---

<Tag
  aria-label={label}
  class={cn(
    "panel-dark rounded-card text-glass-foreground",
    className,
  )}
>
  <slot />
</Tag>
