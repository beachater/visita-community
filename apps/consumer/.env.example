PUBLIC_SUPABASE_URL=http://127.0.0.1:55421
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Where scans and the basemap load from. Empty = "/assets" on this site
# (served by the Worker from R2). Set an absolute URL only for other hosts.
PUBLIC_ASSETS_BASE_URL=
# Google Maps Embed API key for in-app directions (admin setting). Empty =
# "Get directions" opens Google/Apple Maps as before, whatever the setting.
PUBLIC_GOOGLE_MAPS_EMBED_KEY=
