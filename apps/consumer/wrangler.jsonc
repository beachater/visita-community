{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "visita-consumer",
  "compatibility_date": "2026-09-24",
  "compatibility_flags": ["nodejs_compat"],
  // Worker vars (non-secret). The service key is a secret:
  //   npx wrangler secret put SUPABASE_SECRET_KEY
  "vars": {
    "SUPABASE_URL": ""
  },
  // Per-IP limits for public write routes. Counters are per Cloudflare location.
  "ratelimits": [
    { "name": "DEMAND_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
    // Usage stats arrive in batches of up to 50 events, a few per page.
    { "name": "TRACK_LIMITER", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } }
  ],
  "r2_buckets": [
    {
      // Public scans and the basemap, served same-origin at /assets/<key>.
      "binding": "ASSETS_BUCKET",
      "bucket_name": "visita-assets-dev",
      // Local dev reads the real bucket instead of an empty simulated one.
      "remote": true
    }
  ]
}
