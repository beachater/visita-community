{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "visita-admin",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-24",
  // The SPA's routes all serve index.html; /api/* runs the Worker first.
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Non-secret: the publishable key is meant for browsers. Local values come
  // from .dev.vars (see .dev.vars.example).
  "vars": {
    "SUPABASE_URL": "https://zgbvtnoticzhlyuavwdc.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable__LuJPCWzTVyuqNRLnzxo9A_pubSq5lL"
  },
  "r2_buckets": [
    {
      // Owner proofs live under owner-proofs/, which the consumer site never serves.
      "binding": "ASSETS_BUCKET",
      "bucket_name": "visita-assets-dev",
      "remote": true
    }
  ]
}
